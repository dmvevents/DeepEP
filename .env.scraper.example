# Scraper Agent Configuration

# LLM Provider
LLM_PROVIDER=openai  # Options: openai, anthropic, litellm
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000

# Web Search Configuration
WEB_SEARCH_PROVIDER=serpapi  # Options: serpapi, brave
SERP_API_KEY=your-serp-api-key
BRAVE_SEARCH_API_KEY=your-brave-api-key
MAX_SEARCH_RESULTS=10

# Database Configuration (shared with main backend)
DATABASE_URL=postgresql://admin:password@postgres:5432/mortgage_calc

# Scraper Behavior
SCRAPER_TIMEOUT=300  # seconds
MAX_RETRIES=3
RETRY_DELAY=5  # seconds
MAX_REASONING_LOOPS=5
MIN_CONFIDENCE_SCORE=70
MIN_COMPLETENESS_SCORE=80

# Caching
CACHE_EXPIRY_DAYS=30
USE_CACHED_RESULTS=True

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_SCRAPES=5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # Options: json, text
LOG_FILE=/var/log/scraper/scraper.log

# Browser/HTTP Configuration
USER_AGENT=Mozilla/5.0 (Mortgage Calculator Scraper Bot; +https://example.com/bot)
REQUEST_TIMEOUT=30
FOLLOW_REDIRECTS=True
MAX_REDIRECTS=5

# Validation
REQUIRE_OFFICIAL_SOURCES=True
OFFICIAL_SOURCE_PATTERNS=.gov,.us,treasurer,tax-rates
BLACKLIST_PATTERNS=realtor.com,zillow.com,trulia.com

# Performance
ENABLE_ASYNC=True
WORKER_THREADS=4

# Testing
TEST_MODE=False
MOCK_LLM_RESPONSES=False
