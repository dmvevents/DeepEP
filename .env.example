# Django Backend Configuration

# Debug mode (set to False in production)
DEBUG=True

# Secret key (generate a new one for production)
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/mortgage_calc
DB_NAME=mortgage_calc
DB_USER=admin
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=gpt-4-turbo-preview

# OCR Configuration
OCR_PROVIDER=deepseek  # Options: deepseek, tesseract
DEEPSEEK_OCR_API_KEY=your-deepseek-api-key
TESSERACT_PATH=/usr/bin/tesseract

# Web Search Configuration
WEB_SEARCH_PROVIDER=serpapi  # Options: serpapi, brave
SERP_API_KEY=your-serp-api-key
BRAVE_SEARCH_API_KEY=your-brave-api-key

# Scraper Configuration
SCRAPER_SERVICE_URL=http://scraper-agent:8001
SCRAPER_CACHE_EXPIRY_DAYS=30
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=300

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Security
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME=60  # minutes
JWT_REFRESH_TOKEN_LIFETIME=1440  # minutes (24 hours)

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Logging
LOG_LEVEL=INFO

# Sentry (optional)
SENTRY_DSN=

# Feature Flags
ENABLE_AUTO_RESCRAPE=True
ENABLE_OCR_PROCESSING=True
ENABLE_DOCUMENT_UPLOAD=True
