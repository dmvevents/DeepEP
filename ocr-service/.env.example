# OCR Service Environment Variables
# Created by: Neumann Rashid AI Development

# OLLAMA Configuration
OLLAMA_HOST=http://host.docker.internal:11434
OCR_PRIMARY_MODEL=granite3.2-vision
OCR_FALLBACK_MODEL=llama3.2-vision:11b

# Confidence threshold (0-100)
CONFIDENCE_THRESHOLD=70

# Database (shared with main backend)
DATABASE_URL=postgresql://admin:secure_password@postgres:5432/mortgage_calc

# Service Configuration
SERVICE_PORT=8003
LOG_LEVEL=INFO
